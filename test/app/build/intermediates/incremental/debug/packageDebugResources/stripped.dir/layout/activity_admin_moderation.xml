<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.admin.AdminModerationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Admin Moderation Console"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Selected Dispute Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAdminDisputeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dispute #1: Damaged Gear Report"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                    <TextView
                        android:id="@+id/tvAdminReporter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Reporter: Muhammad Tanjeem (ID: 1)"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvAdminReportedUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Reported Student: Chandan Acharjee Himel (ID: 3)"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvAdminDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Scratch discovered on lens cap during return."
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Verdict Controls Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Execute Admin Verdict"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                    <!-- Verdict Action Choice -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupVerdictAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipResolve"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Resolve &amp; Adjust Deposit" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDismiss"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dismiss Dispute" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- Deposit Refund Percentage (0% to 100%) -->
                    <TextView
                        android:id="@+id/tvRefundPercentLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Deposit Refund to Borrower: 100%"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRefundPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="100"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="10" />

                    <!-- Trust Score Deduction (-0 to -30) -->
                    <TextView
                        android:id="@+id/tvTrustPenaltyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Trust Score Penalty Deduction: -10 pts"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderTrustPenalty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="10"
                        android:valueFrom="0"
                        android:valueTo="30"
                        android:stepSize="5" />

                    <!-- Account Suspension Toggle -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSuspendAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Suspend / Ban Reported Student Account"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <!-- Verdict Notes -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Official Admin Verdict Notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:lines="3"
                            android:text="Verified condition evidence. Deposit adjusted accordingly." />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Execute Verdict Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecuteVerdict"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="⚖️ Execute Verdict &amp; Notify Parties" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
