<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Received Message Container (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layout_received"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|start"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Owner Mini Avatar -->
        <TextView
            android:id="@+id/tv_received_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/circle_avatar"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:orientation="vertical">

            <!-- Received Text Bubble -->
            <TextView
                android:id="@+id/tv_received_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_messenger_bubble_other"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Hello! Yes it is available."
                android:textColor="@color/messenger_bubble_incoming_text"
                android:textSize="15sp" />

            <!-- Received Photo Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_received_photo"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/img_received_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo"
                    android:src="@drawable/ic_messenger_image" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Received Audio Note -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_received_audio"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/messenger_bubble_incoming"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Play"
                        android:src="@drawable/ic_messenger_call"
                        app:tint="@color/brand_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@drawable/bg_messenger_quick_chip" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0:08"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Received Like Thumb -->
            <ImageView
                android:id="@+id/img_received_like"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Like"
                android:src="@drawable/ic_messenger_like"
                app:tint="@color/messenger_blue"
                android:visibility="gone" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tv_received_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="3:15 PM"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sent Message Container (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layout_sent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Sent Text Bubble -->
            <TextView
                android:id="@+id/tv_sent_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_messenger_bubble_me"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Is this available today?"
                android:textColor="@color/messenger_bubble_outgoing_text"
                android:textSize="15sp" />

            <!-- Sent Photo Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sent_photo"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/img_sent_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo"
                    android:src="@drawable/ic_messenger_image" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Sent Audio Note -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sent_audio"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/messenger_blue"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Play"
                        android:src="@drawable/ic_messenger_mic"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0:08"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sent Like Thumb -->
            <ImageView
                android:id="@+id/img_sent_like"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Like"
                android:src="@drawable/ic_messenger_like"
                app:tint="@color/messenger_blue"
                android:visibility="gone" />

            <!-- Status Row (Timestamp + Seen Indicator) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sent_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3:16 PM"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_sent_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="• Delivered"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <!-- Seen Mini Avatar Indicator (Messenger signature) -->
                <TextView
                    android:id="@+id/tv_seen_avatar"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/circle_avatar"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
