<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Messenger Header Bar -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/surface"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <!-- User Avatar with Active Online Dot -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tv_header_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_avatar"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Green Online Dot -->
            <View
                android:id="@+id/view_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dot_online_messenger" />
        </FrameLayout>

        <!-- User Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Md. Sabbir Hossain Shamim"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:id="@+id/tv_header_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/messenger_active_now"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Messenger Action: Audio Call -->
        <ImageButton
            android:id="@+id/btn_audio_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio Call"
            android:src="@drawable/ic_messenger_call"
            app:tint="@color/messenger_icon_tint" />

        <!-- Messenger Action: Video Call -->
        <ImageButton
            android:id="@+id/btn_video_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video Call"
            android:src="@drawable/ic_messenger_video"
            app:tint="@color/messenger_icon_tint" />

        <!-- Messenger Action: Info -->
        <ImageButton
            android:id="@+id/btn_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Conversation Info"
            android:src="@drawable/ic_messenger_info"
            app:tint="@color/messenger_icon_tint" />
    </LinearLayout>

    <View
        android:id="@+id/divider_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/layout_header" />

    <!-- Marketplace Item Context Card (Official Facebook Marketplace Messenger Feature) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_product_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/messenger_card_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/divider_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Item Thumbnail -->
            <ImageView
                android:id="@+id/img_product_thumb"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@color/surface_variant"
                android:contentDescription="Product Image"
                android:scaleType="centerCrop" />

            <!-- Title & Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_product_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Laptop Charger (Type-C 65W)"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="৳20/hour • DIU Campus"
                    android:textColor="@color/messenger_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messenger_marketplace_listing"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- View Listing Button -->
            <TextView
                android:id="@+id/btn_view_listing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_messenger_quick_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/messenger_view_details"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_typing_indicator"
        app:layout_constraintTop_toBottomOf="@id/card_product_context" />

    <!-- Animated Typing Indicator (Owner typing bubble) -->
    <LinearLayout
        android:id="@+id/layout_typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/scroll_quick_chips"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_typing_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/circle_avatar"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_messenger_bubble_other"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_typing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textColor="@color/muted"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_typing_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="typing…"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Questions Chips Bar (Facebook Marketplace signature feature) -->
    <HorizontalScrollView
        android:id="@+id/scroll_quick_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/divider_input">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_messenger_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/messenger_quick_chip_1"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_meet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_messenger_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/messenger_quick_chip_2"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_pickup_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_messenger_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/messenger_quick_chip_3"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_messenger_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/messenger_quick_chip_4"
                android:textColor="@color/ink"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/divider_input"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar" />

    <!-- Messenger Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- More (+) icon -->
        <ImageButton
            android:id="@+id/btn_action_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:src="@drawable/ic_messenger_plus"
            app:tint="@color/messenger_icon_tint" />

        <!-- Camera icon -->
        <ImageButton
            android:id="@+id/btn_action_camera"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Camera"
            android:src="@drawable/ic_messenger_camera"
            app:tint="@color/messenger_icon_tint" />

        <!-- Gallery image icon -->
        <ImageButton
            android:id="@+id/btn_action_gallery"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Gallery"
            android:src="@drawable/ic_messenger_image"
            app:tint="@color/messenger_icon_tint" />

        <!-- Mic voice note icon -->
        <ImageButton
            android:id="@+id/btn_action_mic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Message"
            android:src="@drawable/ic_messenger_mic"
            app:tint="@color/messenger_icon_tint" />

        <!-- Rounded Message Input Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_messenger_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/messenger_type_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="😊"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Right Action Button: Dynamically toggles between Like (👍) and Send (➤) -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <!-- Send Paperplane Button (Visible when typing) -->
            <ImageButton
                android:id="@+id/btn_send_message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send"
                android:src="@drawable/ic_messenger_send"
                android:visibility="gone"
                app:tint="@color/messenger_blue" />

            <!-- Like Thumbs-up Button (Visible when input is empty) -->
            <ImageButton
                android:id="@+id/btn_send_like"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send Like"
                android:src="@drawable/ic_messenger_like"
                android:visibility="visible"
                app:tint="@color/messenger_blue" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
