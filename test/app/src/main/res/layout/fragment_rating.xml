<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/rating_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/rating_subtitle"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- 5 Interactive Stars -->
        <LinearLayout
            android:id="@+id/layout_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <ImageView
                android:id="@+id/star_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:id="@+id/star_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:id="@+id/star_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:id="@+id/star_4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:id="@+id/star_5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_star_filled" />
        </LinearLayout>

        <!-- Trust Score Animation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_trust_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation_subtle"
            app:layout_constraintTop_toBottomOf="@id/layout_stars"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updated Student Trust Score"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_animated_trust_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="92"
                    android:textColor="@color/brand_primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_trust_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:background="@color/brand_tint"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Highly Trusted Tier"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/tagline_rating"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Review Chips -->
        <TextView
            android:id="@+id/tv_chips_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Quick Feedback Chips"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_trust_score" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:layout_constraintTop_toBottomOf="@id/tv_chips_title">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_smooth"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rating_chip_smooth" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ontime"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_chip_ontime" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recommended"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_chip_recommended" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Submit Review Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_rating"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:backgroundTint="@color/brand_primary"
            android:text="@string/rating_submit"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_group_feedback" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
