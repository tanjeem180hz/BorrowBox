<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Big Circular Avatar -->
    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp">

        <TextView
            android:id="@+id/tv_call_avatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/circle_avatar"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/dot_call_online"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/dot_online_messenger" />
    </FrameLayout>

    <!-- Caller Name -->
    <TextView
        android:id="@+id/tv_call_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Md. Sabbir Hossain Shamim"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Calling Status -->
    <TextView
        android:id="@+id/tv_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/messenger_ringing"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <!-- Messenger Call Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Speaker Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_call_speaker"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔊"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Red End Call Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_call_end"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/danger"
            app:cardCornerRadius="32dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="End Call"
                android:src="@drawable/ic_phone"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Mute Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_call_mute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎙️"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
